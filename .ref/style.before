/* Rock · Paper · Scissors — dark theme, cyan / coral accents */

* { box-sizing: border-box; }

:root {
  color-scheme: dark;
  --bg: #070c16;
  --text: #f5f2e9;
  --muted: #a3aec1;
  --soft: #8e9bb0;
  --teal: #3ee0c4;
  --coral: #ff6f5e;
  --gold: #ffc857;
  --line: rgba(255, 255, 255, .09);
  --line-strong: rgba(255, 255, 255, .16);
  --display: "Outfit", "Segoe UI", system-ui, sans-serif;
  --mono: "Space Mono", ui-monospace, monospace;
  /* The few measurements the whole page reuses. Everything else is a one-off size. */
  --pad: 18px;     /* padding inside a panel */
  --gap: 16px;     /* space between two blocks */
  --label: 9.5px;  /* small uppercase label text */
  --body: 12.5px;  /* normal text */
  --radius: 18px;  /* corners of the inner boxes */
  --pill: 999px;   /* fully rounded corners */
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--display);
  color: var(--text);
  background:
    radial-gradient(900px 620px at 6% -12%, rgba(62, 224, 196, .14), transparent 62%),
    radial-gradient(760px 560px at 102% 108%, rgba(255, 111, 94, .13), transparent 60%),
    linear-gradient(180deg, #0b1322 0%, var(--bg) 60%);
  background-attachment: fixed;
}

.page { max-width: 1220px; margin: 0 auto; padding: 34px 36px 24px; }
:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

/* Topbar */
.topbar { display: flex; align-items: center; justify-content: space-between; gap: var(--gap); }
.brand { display: inline-flex; align-items: center; gap: 11px; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; font-size: 19px; border-radius: 12px; background: linear-gradient(160deg, rgba(62, 224, 196, .22), rgba(62, 224, 196, .05)); border: 1px solid rgba(62, 224, 196, .3); box-shadow: 0 8px 24px -14px rgba(62, 224, 196, .7); }
.brand-text { font-size: 19px; font-weight: 800; letter-spacing: .04em; }
.brand-dot { color: var(--teal); }
.topbar-actions { display: flex; align-items: center; gap: 12px; }
.course-chip { padding: 6px 11px; font-family: var(--mono); font-size: var(--label); letter-spacing: .08em; text-transform: uppercase; color: var(--soft); border: 1px solid var(--line); border-radius: var(--pill); }
.reset-btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px 9px 13px; font: 600 13px/1 var(--display); color: var(--text); background: rgba(255, 255, 255, .04); border: 1px solid var(--line); border-radius: var(--pill); cursor: pointer; transition: background .2s, border-color .2s, transform .15s ease-out; }
.reset-btn:hover { background: rgba(255, 255, 255, .09); border-color: var(--line-strong); }
.reset-btn:active { transform: scale(.96); }
.reset-btn svg { width: 14px; height: 14px; }

/* Hero */
.hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 36px; margin: 32px 0 28px; }
.eyebrow { margin: 0 0 10px; font-family: var(--mono); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--teal); }
.hero-title { margin: 0; font-size: 66px; font-weight: 800; line-height: 1; letter-spacing: -.035em; }
.word { display: inline-block; }
.word + .word { margin-left: .06em; }
.word-paper { color: var(--teal); }
.word-scissors { color: var(--coral); }
.hero-sub { max-width: 320px; margin: 0 0 5px; font-size: 13.5px; line-height: 1.65; color: var(--muted); }
kbd { display: inline-block; min-width: 20px; padding: 2px 5px; font-family: var(--mono); font-size: 10px; line-height: 1.35; text-align: center; color: var(--text); background: rgba(255, 255, 255, .07); border: 1px solid var(--line-strong); border-bottom-width: 2px; border-radius: 5px; }

/* Layout: three panels in the left column, the arena fills the right one */
.game-grid { display: grid; grid-template-columns: 380px 1fr; grid-template-rows: auto auto 1fr; grid-template-areas: "score arena" "choices arena" "rules arena"; gap: 18px; }
.panel { background: linear-gradient(180deg, rgba(255, 255, 255, .055), rgba(255, 255, 255, .022)); border: 1px solid var(--line); border-radius: 26px; box-shadow: 0 30px 70px -42px rgba(0, 0, 0, .9); }

/* Score */
.score-panel { grid-area: score; padding: 6px; }
.score-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
.score-item { padding: 14px 6px 12px; text-align: center; }
.score-item + .score-item { border-left: 1px solid var(--line); }
.score-label { display: block; margin-bottom: 5px; font-size: var(--label); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--soft); }
.score-value { display: block; font-size: 40px; font-weight: 700; line-height: 1; letter-spacing: -.03em; }
.score-player { color: var(--teal); }
.score-draw { color: var(--gold); }
.score-cpu { color: var(--coral); }

/* Choices */
.choices-panel { grid-area: choices; display: flex; flex-direction: column; padding: var(--pad) var(--pad) var(--gap); }
.panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
.panel-head h2 { margin: 0; font-size: 10.5px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
.panel-hint { font-family: var(--mono); font-size: var(--label); color: var(--soft); }
.choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.choice { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; min-height: 112px; padding: var(--gap) 8px var(--pad); font-family: inherit; color: var(--text); background: rgba(255, 255, 255, .03); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; transition: transform .25s ease-out, background .2s, border-color .2s, box-shadow .25s ease-out; }
.choice:hover { transform: translateY(-4px); background: rgba(255, 255, 255, .07); border-color: var(--line-strong); box-shadow: 0 18px 32px -22px rgba(0, 0, 0, .95); }
.choice:active { transform: translateY(-1px) scale(.985); }
.choice-emoji { font-size: 33px; line-height: 1; filter: drop-shadow(0 5px 9px rgba(0, 0, 0, .35)); transition: transform .25s ease-out; }
.choice:hover .choice-emoji { transform: translateY(-2px) scale(1.06); }
.choice-name { font-size: 13.5px; font-weight: 600; }
.choice-key { position: absolute; top: 8px; right: 8px; min-width: 0; padding: 1px 4px; font-size: 9px; color: var(--soft); background: rgba(0, 0, 0, .22); border-color: rgba(255, 255, 255, .09); border-bottom-width: 1px; }
.choice.is-selected { border-color: rgba(62, 224, 196, .55); background: linear-gradient(180deg, rgba(62, 224, 196, .14), rgba(62, 224, 196, .04)); box-shadow: 0 0 0 3px rgba(62, 224, 196, .12); }
.choice:disabled { cursor: default; opacity: .62; }
.choice.is-selected:disabled { opacity: 1; }
.choice:disabled:hover { transform: none; background: rgba(255, 255, 255, .03); border-color: var(--line); box-shadow: none; }
.tip { margin: var(--gap) 0 0; padding-top: 13px; font-size: 12px; line-height: 1.55; color: var(--soft); border-top: 1px solid var(--line); }
.choices-panel .tip { margin-top: auto; }
.tip strong { font-weight: 600; color: var(--muted); }

/* Rules */
.rules-panel { grid-area: rules; display: flex; flex-direction: column; padding: var(--pad) var(--pad) var(--gap); }
.rules-panel .panel-head { margin-bottom: 8px; }
.rules-list { display: flex; flex: 1; flex-direction: column; justify-content: center; gap: 9px; margin: 0; padding: 0; list-style: none; }
.rules-list li { display: flex; align-items: center; gap: 10px; font-size: 11.5px; color: var(--soft); }
.rule-icons { display: inline-flex; align-items: center; gap: 3px; min-width: 72px; font-size: 14px; }
.rule-arrow { font-family: var(--mono); font-size: 9px; color: #6b7890; }

/* Arena */
.arena-panel { grid-area: arena; display: flex; flex-direction: column; gap: var(--gap); min-height: 500px; padding: 22px; overflow: hidden; background: radial-gradient(120% 90% at 50% -20%, rgba(62, 224, 196, .09), transparent 55%), radial-gradient(100% 80% at 100% 120%, rgba(255, 111, 94, .09), transparent 60%), linear-gradient(180deg, rgba(255, 255, 255, .055), rgba(255, 255, 255, .022)); }
.arena-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.pill { display: inline-flex; align-items: center; gap: 5px; padding: 6px 11px; font-family: var(--mono); font-size: var(--label); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: rgba(6, 10, 18, .35); border: 1px solid var(--line); border-radius: var(--pill); }
.pill b { color: var(--text); }
.streak-pill { color: var(--gold); background: rgba(255, 200, 87, .1); border-color: rgba(255, 200, 87, .32); animation: streakIn .4s ease-out; }
.streak-pill b { color: var(--gold); }
.streak-pill[hidden] { display: none; }
@keyframes streakIn { from { opacity: 0; transform: translateY(-4px) scale(.94); } }
.arena { flex: 1; display: grid; grid-template-columns: 1fr 74px 1fr; align-items: stretch; gap: 10px; }
.hand-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; padding: var(--pad) 14px; background: linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .012)); border: 1px solid var(--line); border-radius: 22px; }
.hand-tile.is-player { border-bottom: 2px solid rgba(62, 224, 196, .55); }
.hand-tile.is-cpu { border-bottom: 2px solid rgba(255, 111, 94, .55); }
.hand-label { display: flex; align-items: center; gap: 7px; margin: 0; font-size: var(--label); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
.dot { width: 6px; height: 6px; border-radius: 50%; }
.dot-player { background: var(--teal); box-shadow: 0 0 10px rgba(62, 224, 196, .8); }
.dot-cpu { background: var(--coral); box-shadow: 0 0 10px rgba(255, 111, 94, .8); }
.hand-emoji { display: flex; align-items: center; justify-content: center; height: 1.12em; font-size: 104px; line-height: 1; filter: drop-shadow(0 14px 22px rgba(0, 0, 0, .45)); }
.hand-emoji.is-unknown { font-family: var(--mono); font-size: 60px; font-weight: 700; color: #6f7d95; filter: none; }
.hand-name { min-height: 18px; margin: 0; font-size: var(--body); font-weight: 600; color: var(--soft); }
.hand-name.is-known { color: var(--text); }
.versus { display: flex; align-items: center; justify-content: center; }
.versus span { display: flex; align-items: center; justify-content: center; width: 46px; height: 46px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; color: var(--soft); background: rgba(7, 12, 22, .6); border: 1px solid var(--line-strong); border-radius: 50%; box-shadow: 0 0 0 6px rgba(255, 255, 255, .02); }
.arena.is-shaking .hand-emoji { animation: handShake .62s ease-out; }
@keyframes handShake { 20% { transform: translateY(-10px) rotate(-5deg); } 50% { transform: translateY(6px) rotate(5deg); } 80% { transform: translateY(-6px) rotate(-2deg); } }
.hand-emoji.is-revealed { animation: handReveal .5s ease-out; }
@keyframes handReveal { 0% { opacity: 0; transform: scale(.55) rotate(-14deg); } 65% { transform: scale(1.08) rotate(3deg); } }

/* Result */
.result { display: flex; flex-direction: column; justify-content: center; gap: 4px; min-height: 88px; padding: 15px 20px; background: rgba(0, 0, 0, .22); border: 1px solid var(--line); border-radius: var(--radius); transition: background .35s, border-color .35s, box-shadow .35s; }
.result-title { margin: 0; font-size: 27px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; }
.result-sub { margin: 0; font-size: var(--body); line-height: 1.5; color: var(--muted); }
.result[data-state="win"] { background: linear-gradient(90deg, rgba(62, 224, 196, .15), rgba(62, 224, 196, .035)); border-color: rgba(62, 224, 196, .38); box-shadow: inset 3px 0 0 var(--teal); }
.result[data-state="lose"] { background: linear-gradient(90deg, rgba(255, 111, 94, .15), rgba(255, 111, 94, .035)); border-color: rgba(255, 111, 94, .38); box-shadow: inset 3px 0 0 var(--coral); }
.result[data-state="draw"] { background: linear-gradient(90deg, rgba(255, 200, 87, .13), rgba(255, 200, 87, .03)); border-color: rgba(255, 200, 87, .35); box-shadow: inset 3px 0 0 var(--gold); }
.result[data-state="win"] .result-title { color: var(--teal); }
.result[data-state="lose"] .result-title { color: var(--coral); }
.result[data-state="draw"] .result-title { color: var(--gold); }

/* Footer */
.footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 4px 0; font-size: 11px; color: #7c899e; }
